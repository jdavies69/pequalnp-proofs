theorem lower (u : Fin 120) (f : DMFormula 11) (hf : positive f)
    (correct : ∀ x, f.eval (extra u x) = edge x) : 15 ≤ f.leaves := by
  let A := fun a => extra u (bits (pos a))
  let B := fun b => extra u (bits (neg b))
  have valid (i : Fin 11) : good (weight (key u)) (scale (key u))
      (univ.filter (fun a => A a i = true)) (univ.filter (fun b => B b i = false)) := by
    let pred (v w : Fin 12 → Bool) := good (weight (key u)) (scale (key u))
      (univ.filter (fun a => v a = true)) (univ.filter (fun b => w b = false))
    change pred (fun a => A a i) (fun b => B b i)
    by_cases h : i.val < 10
    · have eqp : (fun a => A a i) = (fun a => P a ⟨i.val,h⟩) := by funext a; simp [A,extra,h,P]
      have eqn : (fun b => B b i) = (fun b => N b ⟨i.val,h⟩) := by funext b; simp [B,extra,h,N]
      rw [eqp,eqn]
      exact baseOK (key u) ⟨i.val,h⟩
    · have eqp : (fun a => A a i) = (fun a => evaluate (menu u) (P a)) := by funext a; simp [A,extra,h,P]
      have eqn : (fun b => B b i) = (fun b => evaluate (menu u) (N b)) := by funext b; simp [B,extra,h,N]
      rw [eqp,eqn]
      exact extraOK u
  have hp : ∀ a : Fin 12, edge (bits (pos a)) = true := by decide
  have hn : ∀ b : Fin 12, edge (bits (neg b)) = false := by decide
  have hb := treeBound (weight (key u)) (scale (key u)) A B valid f univ univ hf
    (fun a _ => (correct _).trans (hp a)) (fun b _ => (correct _).trans (hn b))
  have tot : ∀ k : Key, 14 * scale k < area (weight k) univ univ := by decide
  have posD : ∀ k : Key, 0 < scale k := by decide
  by_contra! h
  have sm : (f.leaves : ℤ) ≤ 14 := by omega
  have lim := mul_le_mul_of_nonneg_left sm (le_of_lt (posD (key u)))
  have contra := tot (key u)
  rw [mul_comm 14] at contra
  omega
/-- The first ten inputs include the fixed AND of variables 0 and 4.
The eleventh input is one more gate applied to any of those ten wires. -/
def inputs (g : Gate) (x : Fin 9 → Bool) (i : Fin 11) : Bool :=
  if h : i.val < 10 then augment x ⟨i.val,h⟩ else evaluate g (augment x)

private theorem menu_covers : ∀ (op : Fin 3) (a b : Fin 10), a ≤ b →
    (op = 2 → a = b) → ∃ u : Fin 120, menu u = ⟨op,a,b⟩ := by decide

private theorem choose_gate (g : Gate) : ∃ u : Fin 120, ∀ v, evaluate (menu u) v = evaluate g v := by
  rcases g with ⟨op,a,b⟩
  by_cases hn : op = 2
  · obtain ⟨u,hu⟩ := menu_covers op a a le_rfl (fun _ => rfl)
    refine ⟨u,fun v => ?_⟩
    rw [hu]
    simp [evaluate,hn]
  · by_cases hab : a ≤ b
    · obtain ⟨u,hu⟩ := menu_covers op a b hab (fun h => (hn h).elim)
      exact ⟨u,fun _ => by rw [hu]⟩
    · obtain ⟨u,hu⟩ := menu_covers op b a (le_of_not_ge hab) (fun h => (hn h).elim)
      refine ⟨u,fun v => ?_⟩
      rw [hu]
      fin_cases op <;> simp_all [evaluate, Bool.and_comm, Bool.or_comm]

/-- Every monotone binary formula using those eleven wires to compute the
Petersen edge function has at least fifteen leaves. -/
theorem sharedGateLowerBound (g : Gate) (f : DMFormula 11) (hf : positive f)
    (correct : ∀ x, f.eval (inputs g x) = edge x) : 15 ≤ f.leaves := by
  obtain ⟨u,hu⟩ := choose_gate g
  apply lower u f hf
  intro x
  have he : extra u x = inputs g x := by
    funext i
    simp only [extra, inputs, hu]
  rw [he]
  exact correct x
end PetersenSharedGate

