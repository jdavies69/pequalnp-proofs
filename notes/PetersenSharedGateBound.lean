def basic (k : Key) (i : Fin 10) := good (weight k) (scale k)
  (univ.filter (fun a => P a i = true)) (univ.filter (fun b => N b i = false))
def added (u : Fin 120) := good (weight (key u)) (scale (key u))
  (univ.filter (fun a => evaluate (menu u) (P a) = true))
  (univ.filter (fun b => evaluate (menu u) (N b) = false))
