import Mathlib
import PEqualNP.Defs

/-!
# The Petersen graph after two gates

The fixed first gate computes the AND of inputs 0 and 4. The second gate may
compute AND, OR, or NOT of available wires. Both gate outputs and all original
inputs are available to every leaf of the remaining monotone formula. The
final theorem requires at least 15 leaves in that formula, or at least 14
binary gates. Thus this circuit class uses at least 16 gates in total.

The lower bound uses the 12 edge inputs and 12 maximal independent sets.
For every choice of second gate a signed integer weight matrix has total
weight greater than 14 times its scale. An input leaf separates a rectangle
of weight at most that scale. The formula partitions the root rectangle among
its leaves. All finite weight inequalities are verified in Lean.
-/
namespace PetersenSharedGate
open PEqualNP.MetaComplexity Finset

def pos : Fin 12 → ℕ := ![3, 6, 12, 24, 17, 33, 66, 132, 264, 160, 320, 288]
def neg : Fin 12 → ℕ := ![42, 50, 69, 104, 116, 138, 201, 208, 261, 276, 385, 402]
def bits (m : ℕ) (i : Fin 9) := m.testBit i.val
def augment (x : Fin 9 → Bool) (i : Fin 10) : Bool :=
  if h : i.val < 9 then x ⟨i.val,h⟩ else x 0 && x 4
def P (a : Fin 12) := augment (bits (pos a))
def N (b : Fin 12) := augment (bits (neg b))
def edge (x : Fin 9 → Bool) :=
  (x 0 && x 1) || (x 1 && x 2) || (x 2 && x 3) || (x 3 && x 4) || (x 4 && x 0) ||
  (x 0 && x 5) || (x 1 && x 6) || (x 2 && x 7) || (x 3 && x 8) ||
  (x 5 && x 7) || (x 6 && x 8) || (x 8 && x 5)


def area (W : Fin 12 → Fin 12 → ℤ) (S T : Finset (Fin 12)) : ℤ := ∑ a ∈ S, ∑ b ∈ T, W a b
def good (W : Fin 12 → Fin 12 → ℤ) (d : ℤ) (A B : Finset (Fin 12)) : Prop :=
  A.powerset.filter (fun S => d < ∑ b ∈ B, max (∑ a ∈ S, W a b) 0) = ∅

theorem leafBound {n : ℕ} (W : Fin 12 → Fin 12 → ℤ) (d : ℤ)
    (P N : Fin 12 → Fin n → Bool) (i : Fin n)
    (cert : good W d (univ.filter (fun a => P a i = true)) (univ.filter (fun b => N b i = false)))
    (S T : Finset (Fin 12)) (hs : ∀ a ∈ S, P a i = true) (ht : ∀ b ∈ T, N b i = false) :
    area W S T ≤ d := by
  let B := univ.filter (fun b => N b i = false)
  have hc : T ⊆ B := fun b hb => mem_filter.mpr ⟨mem_univ _,ht _ hb⟩
  have hr : S ⊆ univ.filter (fun a => P a i = true) := fun a ha => mem_filter.mpr ⟨mem_univ _,hs _ ha⟩
  have lim : (∑ b ∈ B, max (∑ a ∈ S, W a b) 0) ≤ d := by
    by_contra! h
    exact notMem_empty S (cert ▸ mem_filter.mpr ⟨mem_powerset.mpr hr,h⟩)
  unfold area
  rw [sum_comm]
  calc
    _ ≤ ∑ b ∈ T, max (∑ a ∈ S, W a b) 0 := sum_le_sum fun b _ => le_max_left _ _
    _ ≤ ∑ b ∈ B, max (∑ a ∈ S, W a b) 0 := sum_le_sum_of_subset_of_nonneg hc (fun b _ _ => le_max_right _ _)
    _ ≤ d := lim

def positive {n : ℕ} : DMFormula n → Prop
  | .lit _ s => s = true
  | .and f g | .or f g => positive f ∧ positive g

theorem treeBound {n : ℕ} (W : Fin 12 → Fin 12 → ℤ) (d : ℤ)
    (P N : Fin 12 → Fin n → Bool)
    (valid : ∀ i : Fin n, good W d (Finset.univ.filter (fun a => P a i = true))
      (Finset.univ.filter (fun b => N b i = false))) (f : DMFormula n) (S T : Finset (Fin 12))
    (hf : positive f) (hp : ∀ a ∈ S, f.eval (P a) = true)
    (hn : ∀ b ∈ T, f.eval (N b) = false) : area W S T ≤ d * (f.leaves : ℤ) := by
  induction f generalizing S T with
  | lit i s =>
    change s = true at hf
    subst s
    simpa only [DMFormula.leaves, Nat.cast_one, mul_one] using leafBound W d P N i (valid i) S T hp hn
  | or f g ihf ihg =>
    let c := fun a => f.eval (P a) = true
    have l := ihf (S.filter c) T hf.1 (fun a ha => (mem_filter.mp ha).2)
      (fun b hb => (Bool.or_eq_false_iff.mp (hn b hb)).1)
    have r := ihg (S.filter (fun a => ¬ c a)) T hf.2 (by
      intro a ha
      obtain ⟨ha,hc⟩ := mem_filter.mp ha
      have h := hp a ha
      change (f.eval (P a) || g.eval (P a)) = true at h
      simpa [Bool.eq_false_iff.mpr hc] using h)
      (fun b hb => (Bool.or_eq_false_iff.mp (hn b hb)).2)
    have h : area W (S.filter c) T + area W (S.filter (fun a => ¬ c a)) T = area W S T :=
      sum_filter_add_sum_filter_not S c _
    rw [DMFormula.leaves, Nat.cast_add, mul_add, ← h]
    exact add_le_add l r
  | and f g ihf ihg =>
    let c := fun b => f.eval (N b) = false
    have l := ihf S (T.filter c) hf.1 (fun a ha => (Bool.and_eq_true_iff.mp (hp a ha)).1)
      (fun b hb => (mem_filter.mp hb).2)
    have r := ihg S (T.filter (fun b => ¬ c b)) hf.2
      (fun a ha => (Bool.and_eq_true_iff.mp (hp a ha)).2) (by
        intro b hb
        obtain ⟨hb,hc⟩ := mem_filter.mp hb
        have h := hn b hb
        change (f.eval (N b) && g.eval (N b)) = false at h
        have hy : f.eval (N b) = true := by simpa [c] using hc
        simpa [hy] using h)
    have h : area W S (T.filter c) + area W S (T.filter (fun b => ¬ c b)) = area W S T := by
      unfold area
      rw [← sum_add_distrib]
      exact sum_congr rfl (fun a _ => sum_filter_add_sum_filter_not T c _)
    rw [DMFormula.leaves, Nat.cast_add, mul_add, ← h]
    exact add_le_add l r


