structure Gate where
  op : Fin 3
  left : Fin 10
  right : Fin 10
  deriving DecidableEq

def evaluate (g : Gate) (v : Fin 10 → Bool) : Bool :=
  if g.op = 0 then v g.left && v g.right else if g.op = 1 then v g.left || v g.right else !(v g.left)

